# ── Supabase ──────────────────────────────────────────────────────────
# Crie um projeto em https://supabase.com e copie as chaves do dashboard
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJI...
SUPABASE_SERVICE_KEY=eyJhbGciOiJI...   # service_role key (backend only)

# ── Anthropic ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Metabase ──────────────────────────────────────────────────────────
METABASE_URL=https://metabase.kovi.com.br
METABASE_SESSION_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
METABASE_DB_ID=340

# ── Mapbox ────────────────────────────────────────────────────────────
# Crie token em https://account.mapbox.com (scope: styles:tiles)
MAPBOX_TOKEN=pk.eyJ1IjoiLi4u...

# ── Google (Gmail + Sheets) ───────────────────────────────────────────
# Crie uma Service Account com Domain-Wide Delegation no Google Cloud Console
# Baixe o JSON e aponte o caminho aqui
GOOGLE_SA_JSON=/app/secrets/sa.json
GOOGLE_SA_SUBJECT=seu.email@kovi.com.br   # e-mail a impersonar (ou deixe em branco para usar o SA diretamente)

# ── Flask ─────────────────────────────────────────────────────────────
SECRET_KEY=gere-uma-chave-aleatoria-aqui
ALLOWED_DOMAIN=kovi.com.br
PORT=8000
